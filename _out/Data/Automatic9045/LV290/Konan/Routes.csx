    static IReadOnlyList<string> CreateEntrance(IReadOnlyList<string> prefix, IReadOnlyList<string> main, IReadOnlyList<string> postfix) => [
        "お待たせいたしました。", .. main, "整理券をお取りください。",
        "この車は", .. prefix, .. main, .. postfix,
        "後乗り", "前降り", "後払いです。", "ご乗車の際", "整理券をお取りください。", "危険物の持ち込みはおやめください。",
